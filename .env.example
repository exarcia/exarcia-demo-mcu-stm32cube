# Local Exarcia provisioning values (Wi-Fi / device credentials).
# Copy to .env.local and fill in real values.  Never commit .env.local.
EXARCIA_WIFI_SSID=
EXARCIA_WIFI_PASSWORD=
EXARCIA_CORE_URL=https://core.exarcia.dev
EXARCIA_DEVICE_IDENTITY=
EXARCIA_DEVICE_IDENTITY_TYPE=psk
EXARCIA_DEVICE_PSK=
EXARCIA_ORG_SLUG=
EXARCIA_BATCH_ID=
EXARCIA_PROVISIONING_METHOD=individual
EXARCIA_TLS_SKIP_HOSTNAME=false
EXARCIA_CA_CERT_FILE=
